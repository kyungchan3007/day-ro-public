{
  "name": "@dayro/ui",
  "version": "0.0.0",
  "private": true,
  "description": "데이로 범용 UI (L1) — 두 앱이 같은 모양으로 쓰는 토큰 · 기본 컴포넌트. 빌드 없이 소스를 앱이 transpile 한다.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
